{
  "rules": {
    
    "gg": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": ["j", "NG"]
        }
      }
    ],

    "ng": [
      {
        "when": {
          "before-vowel": true
        },
        "action": {
          "type": "token",
          "value": ["Ng"]
        }
      }
    ],

    "w": [
      {
        "when": {
          "word-start": true
        },
        "action": {
          "type": "literal",
          "value": "ও"
        }
      },
      {
        "when": {
          "after-consonant": true
        },
        "action": {
          "type": "token",
          "value": ["b"]
        }
      }
    ],

    ",,": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": [",.", "|"]
        }
      }
    ]
  }
}
