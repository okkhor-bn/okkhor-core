{
  "rules": {
    "kkh": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": ["k", "Sh"]
        }
      }
    ],
    "gg": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": ["j", "NG"]
        }
      }
    ],

    "ggg": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": ["g", "g"]
        }
      }
    ],

    "ng": [
      {
        "when": {
          "before-vowel": true
        },
        "action": {
          "type": "token",
          "value": ["Ng"]
        }
      }
    ],

    "w": [
      {
        "when": {
          "word-start": true
        },
        "action": {
          "type": "literal",
          "value": "ও"
        }
      },
      {
        "when": {
          "after-consonant": true
        },
        "action": {
          "type": "token",
          "value": ["b"]
        }
      }
    ],

    ",,": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": [".,", ";"]
        }
      }
    ],
    ";;": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "literal",
          "value": ";"
        }
      }
    ],

    "rya": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": ["r", ";", "`", "y", "a"]
        }
      }
    ],
    "..": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "literal",
          "value": "."
        }
      }
    ],
    "oo": [
      {
        "when": {
          "always": true
        },
        "action": {
          "type": "token",
          "value": [":"]
        }
      }
    ],
    "h'": [
      {
        "when": {
          "word-start": true
        },
        "action": {
          "type": "literal",
          "value": "ঽ"
        }
      }
    ]
  }
}
